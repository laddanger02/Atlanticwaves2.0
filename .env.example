# Copy to .env and fill in values from your Deriv OAuth app.
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
DERIV_CLIENT_ID=YOUR_DERIV_OAUTH_CLIENT_ID
# Generate a long random value. Keep it secret and never commit .env.
SESSION_SECRET=replace-with-a-long-random-secret
# Only enable real-money orders after testing the demo account.
ALLOW_REAL_TRADING=false
